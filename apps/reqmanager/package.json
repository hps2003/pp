{
  "name": "reqmanager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "企業內部客戶與需求管理平台（PRD v0.3）— User Flow / Wireframe 實作與 API 串接",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:api": "node --test tests/api/*.test.ts",
    "test:e2e": "node tests/e2e/run.ts",
    "check": "npm run typecheck && npm test && npm run test:api"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.8.0",
    "vite": "^8.0.0"
  }
}
